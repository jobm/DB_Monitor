{
  "name": "catalogdb-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "database.hostname": "postgres-catalog",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "postgres",
    "database.dbname": "postgres",
    "database.server.name": "catalogdb",
    "topic.prefix": "catalogdb", 
    "table.include.list": "public.categories,public.products",
    "slot.name": "catalogdb_slot",
    "publication.autocreate.mode": "filtered",
    "database.history.kafka.bootstrap.servers": "kafka:9092",
    "database.history.kafka.topic": "dbhistory.catalogdb"
  }
}